# Configuração do Portal Financeiro Cinexpan
# Copie este arquivo para .env.local e preencha os valores.
# IMPORTANTE: .env.local NÃO é versionado (fica só na sua máquina/servidor).

# --- Credenciais da API do Omie (Aplicativo > Configurações > API) ---
OMIE_APP_KEY=
OMIE_APP_SECRET=

# --- Banco de dados PostgreSQL ---
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
# No servidor (Postgres local) o instalador preenche isto automaticamente.
DATABASE_URL=postgresql://cinexpan:troque_esta_senha@localhost:5432/cinexpan_financeiro
